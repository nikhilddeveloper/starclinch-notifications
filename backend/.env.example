DEBUG=true
SECRET_KEY=local-development-only-change-before-deploying-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
# Local default: SQLite. Deployment requires persistent PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database
NOTIFICATIONS_DRY_RUN=true
# Simulate WhatsApp independently when global dry run is false.
WHATSAPP_DRY_RUN=false
NOTIFICATIONS_INLINE=true
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
POSTMARKAPP_TOKEN=
POSTMARK_FROM_EMAIL=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Comma-separated recipients allowed for real sandbox sends.
SANDBOX_EMAILS=
SANDBOX_PHONES=
SANDBOX_PUSH_IDS=
# Optional first-deploy bootstrap; remove ADMIN_PASSWORD after creation.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
